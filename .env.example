# Copy this file to .env and adjust values as needed.

# ===== Backend (.NET API) =====
# EF Core SQLite connection string. Relative paths resolve from the API's working directory.
DB_CONNECTION_STRING=Data Source=app_data/app.db
# Port the API listens on (used when ASPNETCORE_URLS is not supplied by the host, and by docker-compose)
API_PORT=5080

# ===== Frontend (Angular) =====
# Base URL the Angular app uses to call the API. Leave empty for same-origin (nginx proxy in Docker).
API_URL=http://localhost:5080
# Host port the frontend is published on by docker-compose
FRONTEND_PORT=4200

# ===== Telemetry (optional) =====
# OTLP endpoint for OpenTelemetry export (traces/metrics/logs from ServiceDefaults).
# Leave empty to disable the exporter. When running under Aspire, the AppHost
# injects the dashboard's endpoint automatically and that value takes precedence.
OTEL_EXPORTER_OTLP_ENDPOINT=
